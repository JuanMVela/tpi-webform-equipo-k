<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TPIWebForm_equipo_K.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>E-Commerce</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navbar de Bootstrap -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="Inicio.aspx">Mi eCommerce</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="Inicio.aspx">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="Catalogo.aspx">Catálogo</a></li>

                        <asp:PlaceHolder ID="phInvitado" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" href="Registro.aspx">Registrate</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Login.aspx">Inicia sesión</a>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phLogueado" runat="server" Visible="false">
                            <li class="nav-item dropdown">
                                <button type="button"
                                    class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                                    id="menuUsuario" data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        width="22" height="22" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round"
                                        aria-hidden="true">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
                                    </svg>

                                    <asp:Label ID="lblNombreUsuario" runat="server" />
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow"
                                    aria-labelledby="menuUsuario">
                                    <li class="px-3 py-2">
                                        <div class="fw-semibold">Mi cuenta</div>
                                        <asp:Label ID="lblEmailUsuario" runat="server"
                                            CssClass="small text-muted text-break" />
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item" href="MiPerfil.aspx">Datos personales
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="MisDirecciones.aspx">Mis direcciones
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="MisCompras.aspx">Mis compras
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <asp:Button ID="btnSalir" runat="server"
                                            Text="Cerrar sesión"
                                            CssClass="dropdown-item text-danger"
                                            CausesValidation="false"
                                            OnClick="btnSalir_Click" />
                                    </li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>
                        <li class="nav-item me-2">
                            <a class="nav-link" href="Carrito.aspx">
                                <span class="visually-hidden">Carrito</span>

                                <span class="position-relative d-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round"
                                        aria-hidden="true" focusable="false">
                                        <path d="M2 3h3l2.5 12h12l2-8H6" />
                                        <circle cx="9" cy="20" r="1" />
                                        <circle cx="18" cy="20" r="1" />
                                    </svg>

                                    <asp:Label ID="lblCantidadCarrito" runat="server"
                                        CssClass="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                        Visible="false" />
                                </span>
                            </a>
                        </li>
                        <!-- Menú desplegable de Administración -->
                        <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link fw-bold" href="AdminDashboard.aspx">Panel Admin</a>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Contenedor principal donde se cargarán las páginas -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
